---
import {
  storyboardOsDemoReel,
  getPublishedSequence,
} from '@storyboard-os/cinematic-domain';

const reel = storyboardOsDemoReel;
const sequences = reel.items.map(item => {
  const board = getPublishedSequence(item.sequenceId);
  return board ? { board, take: item.take } : null;
}).filter((row): row is { board: NonNullable<ReturnType<typeof getPublishedSequence>>; take?: string } => row !== null);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:" />
  <title>Cinematic Storyboard — Production Sequence Planner</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100vh; }
    body {
      background: #0b1120;
      color: #f1f5f9;
      font-family: ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      display: flex; flex-direction: column;
    }

    /* ─── Focus polish ─── */
    a:focus-visible, button:focus-visible,
    [role="button"]:focus-visible, [tabindex]:focus-visible {
      outline: 2px solid #94a3b8;
      outline-offset: 2px;
      border-radius: 3px;
    }

    .page {
      flex: 1;
      max-width: 720px;
      margin: 0 auto;
      padding: 80px 24px 80px;
      display: flex; flex-direction: column; justify-content: center;
    }

    .label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: #334155; margin-bottom: 16px;
    }

    h1 {
      font-size: 36px; font-weight: 800; color: #f1f5f9;
      line-height: 1.15; margin-bottom: 16px;
    }

    .subtitle {
      font-size: 15px; color: #64748b; line-height: 1.7;
      margin-bottom: 48px; max-width: 560px;
    }

    .sequence-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 32px;
    }

    .sequence-card {
      display: flex; flex-direction: column; gap: 8px;
      padding: 24px;
      background: #0f1825;
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.15s;
    }
    .sequence-card:hover { border-color: rgba(255,255,255,0.18); }
    .sequence-card-label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: #334155;
    }
    .sequence-card-title {
      font-size: 17px; font-weight: 700; color: #f1f5f9;
    }
    .sequence-card-desc {
      font-size: 13px; color: #475569; line-height: 1.55;
    }
    .sequence-card-meta {
      font-size: 11px; color: #334155; margin-top: 4px;
      display: flex; gap: 12px;
    }
    .sequence-card-cta {
      font-size: 11px; color: #94a3b8; margin-top: 8px;
    }
  </style>
</head>
<body>
  <div class="page">
    <span class="label">Storyboard OS</span>
    <h1>Cinematic Storyboard</h1>
    <p class="subtitle">
      Production sequence planner for trailers, cutscenes, explainer videos,
      and game cinematics. Camera language, timing, assets, VFX/audio needs,
      continuity, readiness, and handoff to your editor or video producer.
    </p>

    <div class="sequence-grid">
      <a class="sequence-card" href={`/reels/${reel.id}`}>
        <span class="sequence-card-label">Reel</span>
        <span class="sequence-card-title">{reel.title}</span>
        <span class="sequence-card-desc">{reel.description}</span>
        <span class="sequence-card-meta">
          <span>{reel.items.length} sequences</span>
          <span>schema {reel.schemaVersion}</span>
        </span>
        <span class="sequence-card-cta">Open reel →</span>
      </a>
      {sequences.map(({ board, take }, index) => (
        <a class="sequence-card" href={`/sequences/${board.id}`}>
          <span class="sequence-card-label">
            Sequence {index + 1}{take ? ` · Take ${take}` : ''}
          </span>
          <span class="sequence-card-title">{board.title}</span>
          <span class="sequence-card-desc">{board.description}</span>
          <span class="sequence-card-meta">
            <span>{board.frames.length} shots</span>
            <span>{board.connections.length} connections</span>
          </span>
          <span class="sequence-card-cta">Open board →</span>
        </a>
      ))}
    </div>
  </div>
</body>
</html>
