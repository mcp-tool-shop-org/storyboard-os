---
import {
  listReelStaticPaths,
  getPublishedSequence,
  type SequencePlaylist,
} from '@storyboard-os/cinematic-domain';

export function getStaticPaths() {
  return listReelStaticPaths();
}

interface Props { playlist: SequencePlaylist; }
const { playlist } = Astro.props;

const sequences = playlist.items.map(item => {
  const board = getPublishedSequence(item.sequenceId);
  return board ? { board, take: item.take } : null;
}).filter((row): row is { board: NonNullable<ReturnType<typeof getPublishedSequence>>; take: string | undefined } => row !== null);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:" />
  <title>{playlist.title} — Cinematic Reel</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100vh; }
    body {
      background: #0b1120;
      color: #f1f5f9;
      font-family: ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a:focus-visible, button:focus-visible {
      outline: 2px solid #94a3b8;
      outline-offset: 2px;
      border-radius: 3px;
    }
    .page {
      max-width: 720px;
      margin: 0 auto;
      padding: 80px 24px;
    }
    .label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: #334155; margin-bottom: 16px;
    }
    h1 { font-size: 32px; font-weight: 800; margin-bottom: 12px; }
    .subtitle { font-size: 15px; color: #64748b; line-height: 1.7; margin-bottom: 32px; }
    .sequence-grid { display: grid; gap: 12px; }
    .sequence-card {
      display: flex; flex-direction: column; gap: 8px;
      padding: 24px;
      background: #0f1825;
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 8px;
      text-decoration: none;
    }
    .sequence-card:hover { border-color: rgba(255,255,255,0.18); }
    .sequence-card-label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: #334155;
    }
    .sequence-card-title { font-size: 17px; font-weight: 700; color: #f1f5f9; }
    .sequence-card-desc { font-size: 13px; color: #475569; line-height: 1.55; }
    .home { display: inline-block; margin-top: 24px; font-size: 12px; color: #64748b; text-decoration: none; }
    .home:hover { color: #94a3b8; }
  </style>
</head>
<body>
  <div class="page">
    <span class="label">Reel</span>
    <h1>{playlist.title}</h1>
    <p class="subtitle">{playlist.description}</p>
    <div class="sequence-grid">
      {sequences.map(({ board, take }, index) => (
        <a class="sequence-card" href={`/sequences/${board.id}`}>
          <span class="sequence-card-label">
            Sequence {index + 1}{take ? ` · Take ${take}` : ''}
          </span>
          <span class="sequence-card-title">{board.title}</span>
          <span class="sequence-card-desc">{board.description}</span>
        </a>
      ))}
    </div>
    <a class="home" href="/">← All sequences</a>
  </div>
</body>
</html>
