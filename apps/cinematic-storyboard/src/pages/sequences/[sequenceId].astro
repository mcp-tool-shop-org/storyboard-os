---
import {
  storyboardOsLaunchTrailer,
  CINEMATIC_TEMPLATES,
  createCinematicStoryboard,
  type Storyboard,
} from '@storyboard-os/cinematic-domain';
import CinematicStoryboardCanvas from '../../components/CinematicStoryboardCanvas';

export function getStaticPaths() {
  const allSequences: Storyboard[] = [
    storyboardOsLaunchTrailer,
    ...CINEMATIC_TEMPLATES.map(t => createCinematicStoryboard(t.id)),
  ];
  return allSequences.map(s => ({
    params: { sequenceId: s.id },
    props: { storyboard: s },
  }));
}

interface Props { storyboard: Storyboard; }
const { storyboard } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{storyboard.title} — Cinematic Storyboard</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { width: 100%; height: 100%; overflow: hidden; }
      body {
        background: #0f172a;
        color: #f1f5f9;
        font-family: ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body>
    <CinematicStoryboardCanvas storyboard={storyboard} client:only="react" />
  </body>
</html>
