---
import {
  listSequenceStaticPaths,
  generateProductionBrief,
  generateProductionMarkdown,
  serializeProductionBriefJson,
  formatProductionBriefCamera,
  getSequenceReadiness,
  humanizeFrameType,
  humanizeStatus,
  humanizeConnectionType,
  humanizeMissingReason,
  getConnectionTypeColor,
  cinematicColors,
  STATUS_LABELS,
  type Storyboard,
} from '@storyboard-os/cinematic-domain';

export function getStaticPaths() {
  return listSequenceStaticPaths();
}

interface Props { storyboard: Storyboard; }
const { storyboard } = Astro.props;
const { sequenceId } = Astro.params;

const brief = generateProductionBrief(storyboard);
const markdownText = generateProductionMarkdown(brief);
const jsonText = serializeProductionBriefJson(brief);
const filename = `${sequenceId}-production-brief`;
const boardUrl = `/sequences/${sequenceId}`;
const readiness = getSequenceReadiness(storyboard);
const readyPct = readiness.total > 0 ? Math.round((readiness.ready / readiness.total) * 100) : 0;

const STATUS_COLORS: Record<string, string> = {
  ready:   '#22C55E',
  partial: '#F97316',
  draft:   '#6B7280',
  blocked: '#EF4444',
};

const TYPE_COLORS: Record<string, string> = {
  sequence:     '#475569',
  shot:         '#3B82F6',
  camera_move:  '#06B6D4',
  action:       '#F97316',
  dialogue:     '#A855F7',
  transition:   '#6366F1',
  vfx:          cinematicColors.vfx,
  audio:        '#22C55E',
  edit_beat:    '#EAB308',
};

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:" />
  <title>{storyboard.title} — Production Brief</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: #0b1120;
      color: #f1f5f9;
      font-family: ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      padding: 48px 24px 120px;
      display: flex; flex-direction: column; align-items: center;
    }

    /* ─── Focus polish ─── */
    a:focus-visible, button:focus-visible,
    [role="button"]:focus-visible, [tabindex]:focus-visible {
      outline: 2px solid #94a3b8;
      outline-offset: 2px;
      border-radius: 3px;
    }
    .page { width: 100%; max-width: 820px; }

    .back-link {
      font-size: 11px; color: #475569; text-decoration: none; margin-bottom: 32px;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .back-link:hover { color: #94a3b8; }

    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .meta { font-size: 13px; color: #475569; margin-bottom: 24px; }
    .meta span { margin-right: 16px; }

    .summary-bar {
      display: flex; gap: 8px; margin-bottom: 32px; flex-wrap: wrap;
    }
    .summary-chip {
      font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 4px;
      letter-spacing: 0.04em;
    }

    .progress-bar {
      width: 100%; height: 6px; background: #1e293b; border-radius: 3px;
      margin-bottom: 40px; overflow: hidden;
    }
    .progress-fill {
      height: 100%; border-radius: 3px; transition: width 0.3s;
    }

    .section-title {
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: #334155; margin-bottom: 12px;
      padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.06);
    }

    .shot-card {
      background: #0f1825;
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 12px;
    }
    .shot-header {
      display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
    }
    .shot-number {
      font-size: 10px; font-weight: 700; color: #334155; min-width: 28px;
    }
    .shot-type-badge {
      font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 3px;
      letter-spacing: 0.06em; text-transform: uppercase;
    }
    .shot-title { font-size: 15px; font-weight: 700; flex: 1; }
    .shot-status-badge {
      font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 3px;
      letter-spacing: 0.06em; text-transform: uppercase;
    }

    .shot-field { margin-top: 10px; }
    .shot-field-label {
      font-size: 10px; font-weight: 600; color: #475569; text-transform: uppercase;
      letter-spacing: 0.08em; margin-bottom: 4px;
    }
    .shot-field-value { font-size: 13px; color: #cbd5e1; line-height: 1.6; }
    .shot-field-list { list-style: none; padding: 0; }
    .shot-field-list li {
      font-size: 12px; color: #94a3b8; padding: 2px 0;
      padding-left: 12px; position: relative;
    }
    .shot-field-list li::before {
      content: '•'; position: absolute; left: 0; color: #334155;
    }

    .conn-section { margin-top: 40px; }
    .conn-table { width: 100%; border-collapse: collapse; font-size: 12px; }
    .conn-table th {
      text-align: left; font-size: 10px; font-weight: 600; color: #475569;
      text-transform: uppercase; letter-spacing: 0.08em; padding: 8px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .conn-table td {
      padding: 8px 12px; color: #94a3b8; border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .conn-type-badge {
      font-size: 9px; font-weight: 700; padding: 2px 5px; border-radius: 3px;
      letter-spacing: 0.04em;
    }

    .export-section { margin-top: 48px; }
    .export-tabs { display: flex; gap: 8px; margin-bottom: 12px; align-items: center; flex-wrap: wrap; }
    .export-tab {
      font-size: 11px; font-weight: 600; padding: 6px 14px; border-radius: 4px;
      background: #0f1825; border: 1px solid rgba(255,255,255,0.07);
      color: #64748b; cursor: pointer; transition: border-color 0.12s;
      font-family: inherit;
    }
    .export-tablist { display: flex; gap: 8px; }
    .export-tab.active,
    .export-tab[aria-selected="true"] { border-color: #475569; color: #f1f5f9; }
    .export-download {
      font-size: 11px; font-weight: 600; padding: 6px 14px; border-radius: 4px;
      background: #0f1825; border: 1px solid rgba(255,255,255,0.12);
      color: #94a3b8; text-decoration: none; margin-left: auto;
    }
    .export-download:hover { color: #f1f5f9; border-color: #475569; }
    .export-block {
      background: #0a0e18; border: 1px solid rgba(255,255,255,0.06);
      border-radius: 6px; padding: 16px; overflow-x: auto;
      font-family: ui-monospace, monospace; font-size: 11px; color: #94a3b8;
      line-height: 1.7; white-space: pre-wrap; max-height: 400px; overflow-y: auto;
    }
  </style>
</head>
<body>
  <div class="page">
    <a class="back-link" href={boardUrl}>← Back to board</a>

    <h1>{brief.title} — Production Brief</h1>
    <div class="meta">
      <span>{brief.totalShots} shots</span>
      <span>Duration: {brief.totalDuration}</span>
      <span>{readyPct}% production-ready</span>
    </div>

    <div class="summary-bar">
      {readiness.ready > 0 && (
        <span class="summary-chip" style={`background: ${STATUS_COLORS.ready}18; border: 1px solid ${STATUS_COLORS.ready}44; color: ${STATUS_COLORS.ready};`}>
          {readiness.ready} {STATUS_LABELS.ready}
        </span>
      )}
      {readiness.partial > 0 && (
        <span class="summary-chip" style={`background: ${STATUS_COLORS.partial}18; border: 1px solid ${STATUS_COLORS.partial}44; color: ${STATUS_COLORS.partial};`}>
          {readiness.partial} {STATUS_LABELS.partial}
        </span>
      )}
      {readiness.draft > 0 && (
        <span class="summary-chip" style={`background: ${STATUS_COLORS.draft}18; border: 1px solid ${STATUS_COLORS.draft}44; color: ${STATUS_COLORS.draft};`}>
          {readiness.draft} {STATUS_LABELS.draft}
        </span>
      )}
      {readiness.blocked > 0 && (
        <span class="summary-chip" style={`background: ${STATUS_COLORS.blocked}18; border: 1px solid ${STATUS_COLORS.blocked}44; color: ${STATUS_COLORS.blocked};`}>
          {readiness.blocked} {STATUS_LABELS.blocked}
        </span>
      )}
    </div>

    <div class="progress-bar">
      <div class="progress-fill" style={`width: ${readyPct}%; background: ${STATUS_COLORS.ready};`}></div>
    </div>

    <!-- Shot list -->
    <div class="section-title">Shot List</div>
    {brief.shots.map(shot => (
      <div class="shot-card">
        <div class="shot-header">
          <span class="shot-number">#{shot.shotNumber}</span>
          <span
            class="shot-type-badge"
            style={`background: ${TYPE_COLORS[shot.type] ?? '#475569'}18; border: 1px solid ${TYPE_COLORS[shot.type] ?? '#475569'}44; color: ${TYPE_COLORS[shot.type] ?? '#475569'};`}
          >
            {humanizeFrameType(shot.type)}
          </span>
          <span class="shot-title">{shot.title}</span>
          <span
            class="shot-status-badge"
            style={`background: ${STATUS_COLORS[shot.status] ?? '#475569'}18; border: 1px solid ${STATUS_COLORS[shot.status] ?? '#475569'}44; color: ${STATUS_COLORS[shot.status] ?? '#475569'};`}
          >
            {humanizeStatus(shot.status)}
          </span>
        </div>

        {shot.missingReasons && shot.missingReasons.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Missing</div>
            <div class="shot-field-value">{shot.missingReasons.map(humanizeMissingReason).join(', ')}</div>
          </div>
        )}

        {shot.intent && (
          <div class="shot-field">
            <div class="shot-field-label">Intent</div>
            <div class="shot-field-value">{shot.intent}</div>
          </div>
        )}

        {shot.visualDescription && (
          <div class="shot-field">
            <div class="shot-field-label">Visual</div>
            <div class="shot-field-value">{shot.visualDescription}</div>
          </div>
        )}

        {shot.camera && formatProductionBriefCamera(shot.camera) && (
          <div class="shot-field">
            <div class="shot-field-label">Camera</div>
            <div class="shot-field-value">{formatProductionBriefCamera(shot.camera)}</div>
          </div>
        )}

        {shot.framing && (
          <div class="shot-field">
            <div class="shot-field-label">Framing</div>
            <div class="shot-field-value">{shot.framing}</div>
          </div>
        )}

        {shot.duration && (
          <div class="shot-field">
            <div class="shot-field-label">Duration</div>
            <div class="shot-field-value">{shot.duration}</div>
          </div>
        )}

        {shot.dialogue.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Dialogue</div>
            <ul class="shot-field-list">
              {shot.dialogue.map(d => <li>{d}</li>)}
            </ul>
          </div>
        )}

        {shot.actionNotes.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Action</div>
            <ul class="shot-field-list">
              {shot.actionNotes.map(a => <li>{a}</li>)}
            </ul>
          </div>
        )}

        {shot.continuity.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Continuity</div>
            <ul class="shot-field-list">
              {shot.continuity.map(c => <li>{c}</li>)}
            </ul>
          </div>
        )}

        {shot.requiredAssets.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Required Assets</div>
            <ul class="shot-field-list">
              {shot.requiredAssets.map(a => <li>{a}</li>)}
            </ul>
          </div>
        )}

        {shot.vfx.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">VFX</div>
            <ul class="shot-field-list">
              {shot.vfx.map(v => <li>{v}</li>)}
            </ul>
          </div>
        )}

        {shot.audio.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Audio</div>
            <ul class="shot-field-list">
              {shot.audio.map(a => <li>{a}</li>)}
            </ul>
          </div>
        )}

        {shot.editNotes && (
          <div class="shot-field">
            <div class="shot-field-label">Edit Notes</div>
            <div class="shot-field-value">{shot.editNotes}</div>
          </div>
        )}

        {shot.checklist.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Checklist</div>
            <ul class="shot-field-list">
              {shot.checklist.map(c => <li>{c}</li>)}
            </ul>
          </div>
        )}

        {shot.testCriteria.length > 0 && (
          <div class="shot-field">
            <div class="shot-field-label">Test Criteria</div>
            <ul class="shot-field-list">
              {shot.testCriteria.map(t => <li>{t}</li>)}
            </ul>
          </div>
        )}
      </div>
    ))}

    <!-- Connections -->
    <div class="conn-section">
      <div class="section-title">Sequence Flow</div>
      <table class="conn-table">
        <thead>
          <tr>
            <th>From</th>
            <th>Type</th>
            <th>To</th>
          </tr>
        </thead>
        <tbody>
          {brief.connections.map(conn => {
            const connColor = getConnectionTypeColor(conn.type);
            return (
              <tr>
                <td>{conn.fromTitle}</td>
                <td>
                  <span class="conn-type-badge" style={`background: ${connColor}18; color: ${connColor};`}>
                    {humanizeConnectionType(conn.type)}
                  </span>
                </td>
                <td>{conn.toTitle}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Export -->
    <div class="export-section">
      <div class="section-title">Export</div>
      <div class="export-tabs">
        <div class="export-tablist" role="tablist" aria-label="Export format">
          <button type="button" class="export-tab active" id="tab-md" role="tab" aria-selected="true" aria-controls="export-content" tabindex="0">Markdown</button>
          <button type="button" class="export-tab" id="tab-json" role="tab" aria-selected="false" aria-controls="export-content" tabindex="-1">JSON</button>
        </div>
        <a
          class="export-download"
          id="export-download"
          href={`data:text/markdown;charset=utf-8,${encodeURIComponent(markdownText)}`}
          download={`${filename}.md`}
        >Download</a>
      </div>
      <pre class="export-block" id="export-content" role="tabpanel" aria-labelledby="tab-md" tabindex="0">{markdownText}</pre>
    </div>
  </div>

  <script define:vars={{ markdownText, jsonText, filename }}>
    const tabMd = document.getElementById('tab-md');
    const tabJson = document.getElementById('tab-json');
    const content = document.getElementById('export-content');
    const download = document.getElementById('export-download');

    function activate(format) {
      const isMd = format === 'md';
      tabMd?.classList.toggle('active', isMd);
      tabJson?.classList.toggle('active', !isMd);
      tabMd?.setAttribute('aria-selected', String(isMd));
      tabJson?.setAttribute('aria-selected', String(!isMd));
      tabMd?.setAttribute('tabindex', isMd ? '0' : '-1');
      tabJson?.setAttribute('tabindex', isMd ? '-1' : '0');
      if (content) {
        content.textContent = isMd ? markdownText : jsonText;
        content.setAttribute('aria-labelledby', isMd ? 'tab-md' : 'tab-json');
      }
      if (download instanceof HTMLAnchorElement) {
        if (isMd) {
          download.href = `data:text/markdown;charset=utf-8,${encodeURIComponent(markdownText)}`;
          download.download = `${filename}.md`;
        } else {
          download.href = `data:application/json;charset=utf-8,${encodeURIComponent(jsonText)}`;
          download.download = `${filename}.json`;
        }
      }
    }

    tabMd?.addEventListener('click', () => activate('md'));
    tabJson?.addEventListener('click', () => activate('json'));

    const tablist = tabMd?.closest('[role="tablist"]');
    tablist?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight' && e.key !== 'Home' && e.key !== 'End') return;
      e.preventDefault();
      const formats = ['md', 'json'];
      let idx = document.activeElement === tabJson ? 1 : 0;
      if (e.key === 'ArrowRight') idx = (idx + 1) % formats.length;
      else if (e.key === 'ArrowLeft') idx = (idx - 1 + formats.length) % formats.length;
      else if (e.key === 'Home') idx = 0;
      else idx = formats.length - 1;
      const format = formats[idx];
      activate(format);
      (format === 'md' ? tabMd : tabJson)?.focus();
    });
  </script>
</body>
</html>
