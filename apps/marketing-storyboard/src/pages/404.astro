---
import { launchRpgStoryboardCampaign } from '@storyboard-os/marketing-domain';
import { textColors, surfaces } from '@storyboard-os/core';

// Same published boards as campaigns/[campaignId].astro getStaticPaths (demo id + title).
const campaigns = [
  { id: launchRpgStoryboardCampaign.id, title: launchRpgStoryboardCampaign.title },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:" />
  <title>Page not found — Marketing Storyboard</title>
  <style define:vars={{
    textHeading: textColors.heading,
    textSecondary: textColors.secondary,
    textMuted: textColors.muted,
    bgPage: surfaces.bgPage,
    bgChrome: surfaces.bgChrome,
  }}>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bgPage);
      color: var(--textHeading);
      font-family: ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 24px;
    }
    a:focus-visible, button:focus-visible {
      outline: 2px solid #94a3b8;
      outline-offset: 2px;
      border-radius: 3px;
    }
    .card {
      width: 100%;
      max-width: 560px;
      background: var(--bgChrome);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 10px;
      padding: 32px;
    }
    .label {
      font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--textSecondary); margin-bottom: 12px;
    }
    h1 { font-size: 24px; font-weight: 800; margin-bottom: 8px; }
    p { font-size: 14px; color: var(--textMuted); line-height: 1.6; margin-bottom: 24px; }
    ul { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
    li a {
      display: block;
      text-decoration: none;
      color: var(--textHeading);
      font-size: 14px; font-weight: 600;
      padding: 12px 14px;
      border-radius: 6px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
    }
    li a:hover { border-color: rgba(255,255,255,0.18); }
    .id { display: block; font-size: 11px; color: var(--textSecondary); font-weight: 500; margin-top: 2px; }
    .home {
      font-size: 12px; color: var(--textMuted); text-decoration: none;
    }
    .home:hover { color: var(--textSecondary); }
  </style>
</head>
<body>
  <div class="card">
    <div class="label">404</div>
    <h1 id="nf-title">Page not found</h1>
    <p id="nf-body">
      That URL is not a published page in this build. Pick a known campaign below,
      or return to the campaign list.
    </p>
    <ul>
      {campaigns.map(c => (
        <li>
          <a href={`/campaigns/${c.id}`}>
            {c.title}
            <span class="id">{c.id}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="home" href="/">← All campaigns</a>
  </div>
  <script>
    // SSG 404 is one page for every miss. Default copy is generic so a dead
    // Handbook click is not diagnosed as a missing campaign id (F-23d5709a).
    const path = window.location.pathname;
    if (/^\/campaigns(\/|$)/.test(path)) {
      document.title = 'Campaign not found — Marketing Storyboard';
      const title = document.getElementById('nf-title');
      const body = document.getElementById('nf-body');
      if (title) title.textContent = 'Campaign not found';
      if (body) {
        body.textContent =
          'That campaign id is not published in this build. Pick a known campaign below, or return to the campaign list.';
      }
    }
  </script>
</body>
</html>
