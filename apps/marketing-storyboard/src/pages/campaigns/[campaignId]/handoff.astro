---
import {
  launchRpgStoryboardCampaign,
  generateCampaignHandoff,
  generateCampaignMarkdown,
  BLOCKING_REASONS,
  FRAME_TYPE_LABELS,
  humanizeMissingReason,
  humanizeFrameType,
  humanizeConnectionType,
  humanizeBeatStatus,
  type Storyboard,
  type MissingSpecReason,
  type MarketingFrameType,
} from '@storyboard-os/marketing-domain';
import { statusLabels, textColors, surfaces } from '@storyboard-os/core';

export function getStaticPaths() {
  const allCampaigns: Storyboard[] = [
    launchRpgStoryboardCampaign,
  ];
  return allCampaigns.map(s => ({
    params: { campaignId: s.id },
    props: { storyboard: s },
  }));
}

interface Props { storyboard: Storyboard; }
const { storyboard } = Astro.props;
const { campaignId } = Astro.params;

const handoff       = generateCampaignHandoff(storyboard);
const markdownText  = generateCampaignMarkdown(handoff);
const jsonText      = JSON.stringify(handoff, null, 2);
const filename      = `${campaignId}-campaign-brief`;
const boardUrl      = `/campaigns/${campaignId}`;
const generatedStamp = handoff.generatedAt.endsWith('Z')
  ? `${handoff.generatedAt.slice(0, -1).replace('T', ' ')} UTC`
  : handoff.generatedAt;
const readyPct      = Math.round(handoff.readiness.readyFraction * 100);

const STATUS_COLORS: Record<string, string> = {
  ready:   '#22C55E',
  partial: '#F97316',
  draft:   '#6B7280',
  blocked: '#EF4444',
};

// Exhaustive over MarketingFrameType — a new schema variant is a compile error.
const TYPE_COLORS: Record<MarketingFrameType, string> = {
  audience:      '#3B82F6',
  message:       '#8B5CF6',
  touchpoint:    '#22C55E',
  asset:         '#F97316',
  approval:      '#EF4444',
  launch_event:  '#EAB308',
  conversion:    '#06B6D4',
  follow_up:     '#6366F1',
  measurement:   '#EC4899',
};

function isMarketingFrameType(type: string): type is MarketingFrameType {
  return Object.prototype.hasOwnProperty.call(FRAME_TYPE_LABELS, type);
}

/** True launch blockers only — mirrors MarketingFrameInspector / BLOCKING_REASONS. */
function launchBlockersFor(missing: readonly MissingSpecReason[]): MissingSpecReason[] {
  return missing.filter(r => BLOCKING_REASONS.has(r));
}

/** Non-blocking incompleteness (excludes advisory depth fields, same as inspector). */
function specGapsFor(missing: readonly MissingSpecReason[]): MissingSpecReason[] {
  return missing.filter(
    r => !BLOCKING_REASONS.has(r) && r !== 'no_proof_points' && r !== 'no_launch_dependencies',
  );
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:" />
  <title>{storyboard.title} — Campaign Brief</title>
  <style define:vars={{
    textHeading: textColors.heading,
    textSecondary: textColors.secondary,
    textMuted: textColors.muted,
    bgPage: surfaces.bgPage,
    bgChrome: surfaces.bgChrome,
  }}>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bgPage);
      color: var(--textHeading);
      font-family: ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    /* ─── Focus polish ─── */
    a:focus-visible, button:focus-visible,
    [role="button"]:focus-visible, [tabindex]:focus-visible {
      outline: 2px solid #94a3b8;
      outline-offset: 2px;
      border-radius: 3px;
    }

    .topbar {
      position: sticky; top: 0; z-index: 40;
      background: rgba(11,17,32,0.97);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 0 24px;
      height: 48px;
      display: flex; align-items: center; gap: 16px;
    }
    .topbar-back { font-size: 12px; color: var(--textSecondary); text-decoration: none; display: flex; align-items: center; gap: 4px; }
    .topbar-back:hover { color: var(--textHeading); }
    .topbar-sep { color: #1e293b; }
    .topbar-title { font-size: 13px; font-weight: 700; color: var(--textHeading); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .topbar-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; color: var(--textSecondary); text-transform: uppercase; }
    .btn-download {
      font-size: 11px; font-weight: 700; letter-spacing: 0.04em;
      padding: 5px 12px; border-radius: 4px; border: none; cursor: pointer;
      text-decoration: none; display: inline-block;
      background: rgba(71,85,105,0.2); color: #94a3b8; border: 1px solid #1e293b;
    }
    .btn-download:hover { background: rgba(71,85,105,0.4); color: #f1f5f9; }

    .page { max-width: 860px; margin: 0 auto; padding: 40px 24px 80px; }

    .hero { margin-bottom: 40px; }
    .hero-title { font-size: 28px; font-weight: 800; color: var(--textHeading); line-height: 1.2; margin-bottom: 10px; }
    .hero-desc { font-size: 15px; color: var(--textSecondary); line-height: 1.65; margin-bottom: 10px; }
    .hero-meta { font-size: 11px; color: var(--textHeading); font-family: ui-monospace, monospace; }

    .section-title {
      font-size: 11px; font-weight: 700; color: var(--textSecondary);
      text-transform: uppercase; letter-spacing: 0.12em;
      margin-bottom: 16px;
      padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .readiness-block { margin-bottom: 40px; }
    .readiness-fraction { font-size: 22px; font-weight: 800; color: #f1f5f9; margin-bottom: 8px; }
    .readiness-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
    .readiness-chip { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; padding: 3px 8px; border-radius: 3px; }

    .beat-list { display: flex; flex-direction: column; gap: 24px; }
    .beat-card { background: var(--bgChrome); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; overflow: hidden; }
    .beat-header { padding: 14px 20px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .beat-num { font-size: 11px; color: var(--textHeading); font-weight: 600; flex-shrink: 0; }
    .beat-type { font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 3px; text-transform: uppercase; letter-spacing: 0.08em; flex-shrink: 0; }
    .beat-title { font-size: 16px; font-weight: 700; color: var(--textHeading); flex: 1; min-width: 0; }
    .beat-status { font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 3px; letter-spacing: 0.06em; flex-shrink: 0; }
    .beat-body { padding: 16px 20px; display: flex; flex-direction: column; gap: 14px; }
    .beat-summary { font-size: 13px; color: #cbd5e1; line-height: 1.65; }

    .field { display: flex; flex-direction: column; gap: 5px; }
    .field-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--textSecondary); }
    .field-value { font-size: 12px; color: var(--textSecondary); line-height: 1.6; }

    .item-list { display: flex; flex-direction: column; gap: 4px; }
    .item-row { display: flex; gap: 8px; align-items: flex-start; }
    .item-bullet { color: var(--textHeading); flex-shrink: 0; margin-top: 1px; }
    .item-text { font-size: 12px; color: var(--textSecondary); line-height: 1.5; }

    .branch-list { display: flex; flex-direction: column; gap: 6px; }
    .branch-row { display: flex; gap: 8px; align-items: center; }
    .branch-arrow { color: var(--textSecondary); flex-shrink: 0; }
    .branch-dest { font-size: 12px; color: #cbd5e1; font-weight: 600; }
    .branch-type { font-size: 10px; color: var(--textSecondary); }
    .branch-label { font-size: 11px; color: var(--textMuted); font-style: italic; }

    .beat-blocker {
      background: rgba(239,68,68,0.08);
      border: 1px solid rgba(239,68,68,0.25);
      border-radius: 6px;
      padding: 10px 14px;
      font-size: 11px; color: #fca5a5; line-height: 1.55;
    }
    .beat-blocker ul { color: #fca5a5; }
    .beat-spec-gaps {
      background: rgba(249,115,22,0.06);
      border: 1px solid rgba(249,115,22,0.22);
      border-radius: 6px;
      padding: 10px 14px;
      font-size: 11px; color: #fdba74; line-height: 1.55;
    }
    .beat-spec-gaps ul { color: #fdba74; }

    .claim-text {
      background: rgba(139,92,246,0.06);
      border-left: 2px solid #8B5CF6;
      padding: 10px 14px;
      font-size: 12px; color: #c4b5fd; line-height: 1.65;
      font-style: italic;
    }

    .issues-block { margin-top: 48px; }
    .issues-group { margin-bottom: 24px; }
    .issues-list { display: flex; flex-direction: column; gap: 8px; }
    .issue-row { display: flex; gap: 10px; align-items: flex-start; }
    .issue-indicator { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
    .issue-title { font-size: 13px; font-weight: 600; color: var(--textHeading); }
    .issue-id { font-size: 11px; color: var(--textHeading); font-family: ui-monospace, monospace; }
    .issue-detail { font-size: 11px; color: var(--textMuted); }
  </style>
</head>
<body>

  <nav class="topbar">
    <a href={boardUrl} class="topbar-back">← Board</a>
    <span class="topbar-sep">|</span>
    <span class="topbar-title">{storyboard.title}</span>
    <span class="topbar-label">Campaign Implementation Brief</span>
    <button id="btn-md" class="btn-download">↓ Markdown</button>
    <button id="btn-json" class="btn-download">↓ JSON</button>
  </nav>

  <main class="page">

    <div class="hero">
      <h1 class="hero-title">{storyboard.title}</h1>
      {storyboard.description && (
        <p class="hero-desc">{storyboard.description}</p>
      )}
      <p class="hero-meta">Generated {generatedStamp} · Campaign ID: {handoff.id}</p>
    </div>

    <div class="readiness-block">
      <p class="section-title">Campaign Readiness</p>
      <p class="readiness-fraction">
        {handoff.readiness.ready} / {handoff.readiness.total} beats ready
        <span style="font-size: 14px; font-weight: 400; color: var(--textSecondary); margin-left: 8px;">
          ({readyPct}%)
        </span>
      </p>
      <div class="readiness-chips">
        {handoff.readiness.ready > 0 && (
          <span class="readiness-chip" style={`background: ${STATUS_COLORS.ready}18; border: 1px solid ${STATUS_COLORS.ready}44; color: ${STATUS_COLORS.ready}`}>
            {handoff.readiness.ready} {statusLabels.ready}
          </span>
        )}
        {handoff.readiness.partial > 0 && (
          <span class="readiness-chip" style={`background: ${STATUS_COLORS.partial}18; border: 1px solid ${STATUS_COLORS.partial}44; color: ${STATUS_COLORS.partial}`}>
            {handoff.readiness.partial} {statusLabels.partial}
          </span>
        )}
        {handoff.readiness.blocked > 0 && (
          <span class="readiness-chip" style={`background: ${STATUS_COLORS.blocked}18; border: 1px solid ${STATUS_COLORS.blocked}44; color: ${STATUS_COLORS.blocked}`}>
            {handoff.readiness.blocked} {statusLabels.blocked}
          </span>
        )}
        {handoff.readiness.draft > 0 && (
          <span class="readiness-chip" style={`background: ${STATUS_COLORS.draft}18; border: 1px solid ${STATUS_COLORS.draft}44; color: ${STATUS_COLORS.draft}`}>
            {handoff.readiness.draft} {statusLabels.draft}
          </span>
        )}
      </div>
    </div>

    <p class="section-title">Campaign Beats — Implementation Order</p>
    <div class="beat-list">
      {handoff.beats.map((beat, idx) => {
        const typeColor = isMarketingFrameType(beat.type) ? TYPE_COLORS[beat.type] : textColors.secondary;
        const typeLabel = humanizeFrameType(beat.type);
        const statusColor = STATUS_COLORS[beat.status] ?? textColors.secondary;
        const blockers = launchBlockersFor(beat.missing);
        const gaps = specGapsFor(beat.missing);
        return (
          <article class="beat-card">
            <div class="beat-header">
              <span class="beat-num">#{idx + 1}</span>
              <span class="beat-type" style={`background: ${typeColor}22; color: ${typeColor}; border: 1px solid ${typeColor}44`}>
                {typeLabel}
              </span>
              <span class="beat-title">{beat.title}</span>
              <span class="beat-status" style={`background: ${statusColor}18; border: 1px solid ${statusColor}44; color: ${statusColor}`}>
                {humanizeBeatStatus(beat.status)}
              </span>
            </div>

            <div class="beat-body">
              {blockers.length > 0 && (
                <div class="beat-blocker">
                  <strong>⚠ Launch blockers:</strong>
                  <ul style="margin: 6px 0 0 18px; padding: 0;">
                    {blockers.map(code => (
                      <li>{humanizeMissingReason(code)}</li>
                    ))}
                  </ul>
                </div>
              )}
              {gaps.length > 0 && (
                <div class="beat-spec-gaps">
                  <strong>Spec gaps:</strong>
                  <ul style="margin: 6px 0 0 18px; padding: 0;">
                    {gaps.map(code => (
                      <li>{humanizeMissingReason(code)}</li>
                    ))}
                  </ul>
                </div>
              )}

              <p class="beat-summary">{beat.summary}</p>

              {beat.objective && (
                <div class="field">
                  <span class="field-label">Objective</span>
                  <span class="field-value">{beat.objective}</span>
                </div>
              )}

              {beat.audienceSegment && (
                <div class="field">
                  <span class="field-label">Audience</span>
                  <span class="field-value">{beat.audienceSegment}</span>
                </div>
              )}

              {beat.messageClaim && (
                <div class="field">
                  <span class="field-label">Message Claim</span>
                  <p class="claim-text">"{beat.messageClaim}"</p>
                </div>
              )}

              {beat.proofPoints.length > 0 && (
                <div class="field">
                  <span class="field-label">Proof Points</span>
                  <div class="item-list">
                    {beat.proofPoints.map(p => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #8B5CF6">▸</span>
                        <span class="item-text">{p}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.objectionsHandled.length > 0 && (
                <div class="field">
                  <span class="field-label">Objections Handled</span>
                  <div class="item-list">
                    {beat.objectionsHandled.map(o => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #F59E0B">◇</span>
                        <span class="item-text">{o}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.channel && (
                <div class="field">
                  <span class="field-label">Channel</span>
                  <span class="field-value">{beat.channel}</span>
                </div>
              )}

              {beat.conversionGoal && (
                <div class="field">
                  <span class="field-label">Conversion Goal</span>
                  <span class="field-value" style="color: #06B6D4">{beat.conversionGoal}</span>
                </div>
              )}

              {beat.customerStateBefore.length > 0 && (
                <div class="field">
                  <span class="field-label">Customer State — Before</span>
                  <div class="item-list">
                    {beat.customerStateBefore.map(s => (
                      <div class="item-row">
                        <span class="item-bullet">•</span>
                        <span class="item-text">{s}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.customerStateAfter.length > 0 && (
                <div class="field">
                  <span class="field-label">Customer State — After</span>
                  <div class="item-list">
                    {beat.customerStateAfter.map(s => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #22C55E">→</span>
                        <span class="item-text" style="color: #86efac">{s}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.requiredAssets.length > 0 && (
                <div class="field">
                  <span class="field-label">Required Assets</span>
                  <div class="item-list">
                    {beat.requiredAssets.map(a => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #F97316">◆</span>
                        <span class="item-text">{a}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.approvalRequirements.length > 0 && (
                <div class="field">
                  <span class="field-label">Approval Requirements</span>
                  <div class="item-list">
                    {beat.approvalRequirements.map(a => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #EF4444">⊘</span>
                        <span class="item-text">{a}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.launchDependencies.length > 0 && (
                <div class="field">
                  <span class="field-label">Launch Dependencies</span>
                  <div class="item-list">
                    {beat.launchDependencies.map(d => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #F59E0B">▣</span>
                        <span class="item-text">{d}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.metrics.length > 0 && (
                <div class="field">
                  <span class="field-label">Metrics</span>
                  <div class="item-list">
                    {beat.metrics.map(m => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #EC4899">◎</span>
                        <span class="item-text">{m}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.implementationChecklist.length > 0 && (
                <div class="field">
                  <span class="field-label">Implementation Checklist</span>
                  <div class="item-list">
                    {beat.implementationChecklist.map(item => (
                      <div class="item-row">
                        <span class="item-bullet">☐</span>
                        <span class="item-text">{item}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.testCriteria.length > 0 && (
                <div class="field">
                  <span class="field-label">Test Criteria</span>
                  <div class="item-list">
                    {beat.testCriteria.map(t => (
                      <div class="item-row">
                        <span class="item-bullet" style="color: #3B82F6">✦</span>
                        <span class="item-text">{t}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {beat.ownerNotes?.trim() && (
                <div class="field">
                  <span class="field-label">Owner Notes</span>
                  <span class="field-value">{beat.ownerNotes}</span>
                </div>
              )}

              {beat.outgoingBranches.length > 0 && (
                <div class="field">
                  <span class="field-label">Next Steps</span>
                  <div class="branch-list">
                    {beat.outgoingBranches.map(b => (
                      <div class="branch-row">
                        <span class="branch-arrow">→</span>
                        <span class="branch-dest">{b.toTitle}</span>
                        <span class="branch-type">({humanizeConnectionType(b.type)})</span>
                        {b.label && <span class="branch-label">{b.label}</span>}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </main>

  <script define:vars={{ markdownText, jsonText, filename }}>
    function download(content, ext, mime) {
      const blob = new Blob([content], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${filename}.${ext}`;
      a.click();
      URL.revokeObjectURL(url);
    }
    document.getElementById('btn-md')?.addEventListener('click', () => download(markdownText, 'md', 'text/markdown'));
    document.getElementById('btn-json')?.addEventListener('click', () => download(jsonText, 'json', 'application/json'));
  </script>
</body>
</html>
