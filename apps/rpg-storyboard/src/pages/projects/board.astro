---
import ProjectBoard from '../../components/projects/ProjectBoard';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:" />
    <title>Project Board — RPG Storyboard</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { width: 100%; height: 100%; overflow: hidden; }
      body {
        background: #0f172a;
        color: #f1f5f9;
        font-family: ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* ─── Focus polish ─── */
      a:focus-visible, button:focus-visible,
      [role="button"]:focus-visible, [tabindex]:focus-visible {
        outline: 2px solid #94a3b8;
        outline-offset: 2px;
        border-radius: 3px;
      }

      /* ─── Hydration loading state (F-AP-205) ─── */
      .canvas-loading {
        position: fixed; inset: 0;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 16px;
        background: #0f172a;
        color: #94a3b8;
        font-size: 13px; font-weight: 600;
        letter-spacing: 0.04em;
        z-index: 1;
      }
      .canvas-loading-spinner {
        width: 36px; height: 36px;
        border: 3px solid rgba(255,255,255,0.08);
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: canvas-spin 0.9s linear infinite;
      }
      @keyframes canvas-spin {
        to { transform: rotate(360deg); }
      }
      body:has(astro-island > *) .canvas-loading { display: none; }

      /* ─── noscript fallback (F-AP-204) ─── */
      .noscript-fallback {
        position: fixed; inset: 0;
        display: flex; align-items: center; justify-content: center;
        background: #0f172a;
        padding: 24px;
        z-index: 10;
      }
      .noscript-card {
        max-width: 520px;
        padding: 32px;
        background: #0f1825;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        color: #f1f5f9;
        line-height: 1.65;
      }
      .noscript-label {
        font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
        text-transform: uppercase; color: #475569; margin-bottom: 12px;
      }
      .noscript-title {
        font-size: 18px; font-weight: 800; color: #f1f5f9; margin-bottom: 12px;
      }
      .noscript-body { font-size: 14px; color: #94a3b8; margin-bottom: 18px; }
      .noscript-link {
        display: inline-block;
        padding: 10px 18px;
        background: rgba(139,92,246,0.12);
        border: 1px solid rgba(139,92,246,0.32);
        border-radius: 6px;
        color: #c4b5fd;
        text-decoration: none;
        font-size: 13px; font-weight: 700;
        letter-spacing: 0.02em;
      }
      .noscript-link:hover { background: rgba(139,92,246,0.22); }
    </style>
  </head>
  <body>
    <noscript>
      <div class="noscript-fallback">
        <div class="noscript-card">
          <p class="noscript-label">JavaScript required</p>
          <p class="noscript-title">The project board uses an interactive canvas.</p>
          <p class="noscript-body">
            Project authoring runs in your browser — boards, beats, and saved state all live
            in client-side storage. To preview a fully-specced quest as static HTML, open the
            demo handoff brief.
          </p>
          <a class="noscript-link" href="/storyboards/quest-01/handoff">
            Open demo handoff →
          </a>
        </div>
      </div>
    </noscript>
    <div class="canvas-loading" aria-hidden="true">
      <div class="canvas-loading-spinner"></div>
      <div>Loading canvas…</div>
    </div>
    <ProjectBoard client:only="react" />
  </body>
</html>
