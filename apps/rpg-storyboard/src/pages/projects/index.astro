---
import ProjectList from '../../components/projects/ProjectList';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:" />
  <title>Projects — RPG Storyboard</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; }
    body {
      background: #0b1120;
      color: #f1f5f9;
      font-family: ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ─── Focus polish ─── */
    a:focus-visible, button:focus-visible,
    [role="button"]:focus-visible, [tabindex]:focus-visible {
      outline: 2px solid #94a3b8;
      outline-offset: 2px;
      border-radius: 3px;
    }

    .noscript-banner {
      max-width: 720px; margin: 32px auto; padding: 20px 24px;
      background: #0f1825; border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px; color: #94a3b8; font-size: 13px; line-height: 1.6;
    }
    .noscript-banner a { color: #c4b5fd; }
    .topbar {
      position: sticky; top: 0; z-index: 40;
      background: rgba(11,17,32,0.97);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 0 24px; height: 48px;
      display: flex; align-items: center; gap: 16px;
    }
    .topbar-link { font-size: 11px; color: #475569; text-decoration: none; }
    .topbar-link:hover { color: #94a3b8; }
    .topbar-sep  { font-size: 11px; color: #1e293b; }
    .topbar-label {
      font-size: 11px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: #475569;
    }
    .topbar-right {
      margin-left: auto; font-size: 11px; color: #334155;
      text-decoration: none;
    }
    .topbar-right:hover { color: #475569; }
  </style>
</head>
<body>

  <nav class="topbar">
    <a href="/" class="topbar-link">← Home</a>
    <span class="topbar-sep">|</span>
    <span class="topbar-label">Projects</span>
    <a href="/templates" class="topbar-right">Templates →</a>
  </nav>

  <noscript>
    <div class="noscript-banner">
      Project lists are stored in this browser and rendered with JavaScript.
      To preview a static, JavaScript-free handoff, open the
      <a href="/storyboards/quest-01/handoff">demo quest handoff</a>.
    </div>
  </noscript>

  <ProjectList client:only="react" />

</body>
</html>
