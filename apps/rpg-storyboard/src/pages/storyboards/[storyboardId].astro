---
import { tollhouseLedgerProject } from '@storyboard-os/rpg-domain';
import StoryboardCanvas from '../../components/StoryboardCanvas';
import type { Storyboard } from '../../lib/storyboard/schema';

export function getStaticPaths() {
  const project = tollhouseLedgerProject;
  return project.storyboards.map(s => ({
    params: { storyboardId: s.id },
    props: { storyboard: s },
  }));
}

interface Props { storyboard: Storyboard; }
const { storyboard } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{storyboard.title} — RPG Storyboard</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { width: 100%; height: 100%; overflow: hidden; }
      body {
        background: #0f172a;
        color: #f1f5f9;
        font-family: ui-sans-serif, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body>
    <StoryboardCanvas storyboard={storyboard} client:only="react" />
  </body>
</html>
