{
  "name": "storyboard-os",
  "private": true,
  "version": "1.0.0",
  "description": "Visual story-structure platform. rpg-storyboard is the first vertical.",
  "scripts": {
    "dev": "pnpm --filter rpg-storyboard dev",
    "build": "pnpm --filter rpg-storyboard build",
    "preview": "pnpm --filter rpg-storyboard preview",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter rpg-storyboard test:watch",
    "build:all": "pnpm -r build",
    "verify": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
