{
  "name": "@storyboard-os/canvas",
  "version": "1.0.0",
  "description": "Domain-configurable Konva canvas renderer — frames, connections, selection, drag, type badges, connection labels.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-tool-shop-org/storyboard-os.git",
    "directory": "packages/storyboard-canvas"
  },
  "homepage": "https://mcp-tool-shop-org.github.io/storyboard-os/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external react-konva --external konva",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react --external react-konva --external konva",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "konva": ">=9.0.0",
    "react": ">=18.0.0",
    "react-konva": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "konva": "^10.3.0",
    "react": "^19.2.5",
    "react-konva": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
