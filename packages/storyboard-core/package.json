{
  "name": "@storyboard-os/core",
  "version": "1.2.1",
  "description": "Generic storyboard primitives — frame, connection, annotation, template, validation. No domain-specific content.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-tool-shop-org/storyboard-os.git",
    "directory": "packages/storyboard-core"
  },
  "homepage": "https://mcp-tool-shop-org.github.io/storyboard-os/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "storyboard",
    "narrative",
    "frames",
    "connections",
    "validation",
    "game-design"
  ],
  "author": "mcp-tool-shop"
}
